# ---- Handheld (Raspberry Pi 5) configuration ----
# Copy to .env and edit. NEVER commit .env.

# Where the server lives. Use the laptop's WiFi IP (not localhost) so that
# phones on the same WiFi can open the QR join links too.
SERVER_URL=http://192.168.1.50:8888

# Name shown on the website when you claim this handheld.
DEVICE_NAME=Gizmo-01

# Hardware mode: auto | sim | real
#   auto -> real drivers on a Raspberry Pi, simulators everywhere else
DEVICE_MODE=auto

# Where the token, outbox DB, trips and photos live.
DATA_DIR=./data

# --- Runtime ---
# None of these are secrets. LLM provider keys live on the SERVER, not here.
# A direct-key dev mode is allowed for laptop testing only.
LLM_DEV_MODE=false
LLM_DEV_PROVIDER=
LLM_DEV_API_KEY=
LLM_DEV_BASE_URL=
LLM_DEV_MODEL=

# --- Simulator inputs (laptop testing) ---
SIM_GPX=./data/sim/walk.gpx
SIM_START_LAT=11.2588
SIM_START_LNG=75.7804
SIM_SPEED_MPS=1.4
SIM_HEADING_DEG=45

# --- UI ---
UI_THEME=dark
UI_FULLSCREEN=false
SPEECH_ENABLED=true

# --- Safety ---
EMERGENCY_CONTACT_NAME=
EMERGENCY_CONTACT_PHONE=

# --- Server-side reminder (set these in the SERVER's .env, not here) ---
# PUBLIC_BASE_URL=http://192.168.1.50:8888
