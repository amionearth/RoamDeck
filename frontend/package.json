{
  "name": "farfromhome-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FarFromHome / BlindTrip mobile app - HTML+CSS+JS (React) wrapped by Capacitor for Android and iOS, talking to the existing FastAPI server.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 0.0.0.0",
    "cap:sync": "npm run build && cap sync",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:build": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:apk": "npm run android:build",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "doctor": "cap doctor"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/device": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/geolocation": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/motion": "^7.0.0",
    "@capacitor/network": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.0",
    "@capacitor/toast": "^7.0.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/gloock": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "jsbarcode": "^3.12.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.55.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/jsbarcode": "^3.11.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
