APP_NAME="FarFromHome"
SECRET_KEY="temporary-hackathon-secret-key-change-in-prod"
DATABASE_URL="sqlite:///./data/app.db"
DATA_DIR="./data"

# The address phones and the handheld use. MUST NOT be localhost, or every QR code
# will point at the phone's own localhost and fail (see docs/SERVER_TROUBLESHOOTING.md).
# Set it to the laptop's WiFi IPv4 address. Find it with:  ipconfig
PUBLIC_BASE_URL="http://192.168.1.50:8888"

DEMO_MODE=true
MAX_UPLOAD_MB=10
HOST="0.0.0.0"
# 8888, not 8000: port 8000 is taken by another service on the build machine, and it is
# the most contested default there is. The mobile app probes 8888 first and 8000 as a
# fallback, so a server left on the old port is still found.
PORT=8888

# The servers allowed to call this API from a browser or a wrapped mobile app.
# Capacitor serves the app from http://localhost (Android) and capacitor://localhost
# (iOS), so both origins are listed. Add your laptop's WiFi address if you open the
# site from a phone browser. The regex below covers the private ranges too, so this
# list rarely needs editing.
CORS_ORIGINS="http://localhost:5173,http://localhost:8888,http://127.0.0.1:5173,http://127.0.0.1:8888"

# ---------------------------------------------------------------------------
# LLM gateway (brief 01 §5.1: keys live on the SERVER, never on the device).
# Leave them all empty and the handheld falls back to its template content, which
# is a supported outcome. Fill in whichever you have.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# Model ids change often on the free tiers; these are config, not constants.
GEMINI_MODEL="gemini-2.5-flash"
GROQ_MODEL="llama-3.3-70b-versatile"
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# Rate limits for the gateway: per device, and across all devices.
LLM_DEVICE_RPM=20
LLM_GLOBAL_RPM=60
LLM_CACHE_TTL_S=3600
